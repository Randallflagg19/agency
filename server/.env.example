# Скопировать в server/.env. Пароль вписать только в локальный файл.
API_PORT=3000
# На VPS при публикации: NODE_ENV=production и APP_ORIGIN=https://ваш-домен
NODE_ENV=development
APP_ORIGIN=http://localhost:4200
PGHOST=127.0.0.1
# 15432 — SSH-туннель при запуске API на Mac; на VPS использовать 5432.
PGPORT=15432
PGDATABASE=agency_db
PGUSER=agency_app
PGPASSWORD=
